<?xml version="1.0" encoding="utf-8"?>
<!--
    Esta é a variante que de fato vale: com `minSdk = 24`, o qualificador `v21`
    sempre vence a pasta `drawable/` sem qualificador.

    Antes daqui havia `?android:colorBackground`, que resolve contra o tema
    aplicado — e já dava preto no modo escuro, porque `values-night/styles.xml`
    usa `Theme.Black.NoTitleBar`. A troca por uma cor explícita não corrige um
    defeito: ela faz o splash usar a mesma superfície que o aplicativo, em vez
    do branco e preto genéricos do sistema.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
